<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Add New Event"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEventName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="Event Name"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/etEventDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Event Date"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/etEventTime"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Event Time"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/etEventPlace"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Event Place"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/etEventAddress"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Event Address"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/etTicketPrice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Ticket Price"
            android:textColor="@color/black"
            android:inputType="number"
            android:padding="15dp" />

        <EditText
            android:id="@+id/etEventImage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Image Name (example: aisummit)"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/etEventDescription"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Event Description"
            android:textColor="@color/black"
            android:inputType="textMultiLine"
            android:padding="15dp" />

        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#087F5F"
            android:text="ADD EVENT"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>