<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvAttendanceEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event ID:"
        android:layout_marginTop="50dp"
        android:textColor="#000000"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAttendanceEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Email:"
        android:textColor="#333333"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvAttendanceUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="User ID:"
        android:textColor="#333333"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvAttendanceRegistrationId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Registration ID:"
        android:textColor="#333333"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvAttendanceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Status:"
        android:textColor="#008000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAttendanceTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Scanned At:"
        android:textColor="#333333"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvAttendanceMarkedBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Marked By:"
        android:textColor="#333333"
        android:textSize="15sp" />

</LinearLayout>

