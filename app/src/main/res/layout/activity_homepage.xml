<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".homepage">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:scrollbars="none">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="60dp"
            android:paddingEnd="25dp"
            android:paddingBottom="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


<!--                <ImageView-->
<!--                    android:id="@+id/btnProfile"-->
<!--                    android:layout_width="52dp"-->
<!--                    android:layout_height="52dp"-->
<!--                    android:background="@drawable/bg_profile"-->
<!--                    android:clipToOutline="true"-->
<!--                    android:contentDescription="Profile"-->
<!--                    android:scaleType="centerCrop"-->
<!--                    android:src="@drawable/bg_profile"-->
<!--                    tools:ignore="HardcodedText" />-->


<!--                <ImageButton-->
<!--                    android:id="@+id/btnNotification"-->
<!--                    android:layout_width="48dp"-->
<!--                    android:layout_height="48dp"-->
<!--                    -->
<!--                    android:background="@drawable/bg_notification"-->
<!--                    android:contentDescription="Notifications"-->
<!--                    android:src="@drawable/ic_notification"-->
<!--                    tools:ignore="HardcodedText" />-->

            </LinearLayout>




            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Events \nFor You"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:scrollbars="none">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/filterAll"
                        android:layout_width="64dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_filter_selected"
                        android:gravity="center"
                        android:text="All"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/filterToday"
                        android:layout_width="82dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_filter_normal"
                        android:gravity="center"
                        android:text="Today"
                        android:textColor="#6D6D6D"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/filterTrending"
                        android:layout_width="100dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_filter_normal"
                        android:gravity="center"
                        android:text="Trending"
                        android:textColor="#6D6D6D"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/filterNearby"
                        android:layout_width="88dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_filter_normal"
                        android:gravity="center"
                        android:text="Nearby"
                        android:textColor="#6D6D6D"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />


                    <ImageButton
                        android:id="@+id/btnFilter"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_filter_button"
                        android:contentDescription="Filter"
                        android:padding="11dp"
                        android:src="@drawable/ic_filter"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </HorizontalScrollView>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Categories"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />


                <TextView
                    android:id="@+id/tvSeeAllCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textColor="#777777"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>


            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:scrollbars="none">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/categoryAll"
                        android:layout_width="65dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_category_selected"
                        android:gravity="center"
                        android:text="All"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/categoryMusic"
                        android:layout_width="82dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_category_normal"
                        android:gravity="center"
                        android:text="Music"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/categorySports"
                        android:layout_width="82dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_category_normal"
                        android:gravity="center"
                        android:text="Sports"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/categoryFestival"
                        android:layout_width="92dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_category_normal"
                        android:gravity="center"
                        android:text="Festival"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/categoryWorkshop"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_category_normal"
                        android:gravity="center"
                        android:text="Workshop"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />


                    <TextView
                        android:id="@+id/categoryTechnology"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_category_normal"
                        android:gravity="center"
                        android:text="Technology"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </HorizontalScrollView>



            <LinearLayout
                android:id="@+id/eventContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical" />


        </LinearLayout>

    </ScrollView>




    <include
        layout="@layout/bottom_navbar"
        android:layout_width="match_parent"
        android:layout_height="70dp" />


</LinearLayout>