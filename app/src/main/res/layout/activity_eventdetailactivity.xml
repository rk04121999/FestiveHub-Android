<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="50dp">


            <ImageView
                android:id="@+id/eventImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/aisummit"
                android:contentDescription="Event Image"
                tools:ignore="HardcodedText"/>

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="13dp"
                android:background="@drawable/bg_white_circle"
                android:padding="12dp"
                android:src="@drawable/ic_backarrow"
                android:contentDescription="Back"
                tools:ignore="HardcodedText"/>


        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                android:id="@+id/eventName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI technological Summit"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#222222"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/eventDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="📅 20 September 2026"
                android:textColor="#555555"
                android:textSize="20sp"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/eventTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🕐  07:00 PM"
                android:textSize="20sp"
                android:textColor="#555555"
                tools:ignore="HardcodedText"
                />

            <TextView
                android:id="@+id/eventPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📍 Ahmedabad"
                android:textSize="20sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/eventAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Science city,Science City Road,Ahmedabad, Gujarat"
                android:textColor="#777777"
                android:textSize="20sp"

                />


            <TextView
                android:id="@+id/ticketPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Ticket Price"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="₹499"
                android:textColor="#222222"
                android:textSize="22sp"

                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="About Event :-"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/eventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Join us for an exciting event and experience an amazing day with technology, innovation and entertainment. We Provide Detail Information About AI Tools And Technologies And How They Work."
                android:textColor="#666666"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnBookEvent"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#087F5F"
                android:text="BOOK EVENT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

<!--            <Button-->
<!--                android:id="@+id/btnScanAttendance"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginBottom="20dp"-->
<!--                android:text="Scan QR for Attendance"-->
<!--                android:textAllCaps="false"-->
<!--                android:textSize="16sp"-->
<!--                android:visibility="visible" />-->

            <TextView
                android:id="@+id/registrationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="Not Registered"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/registrationQR"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="15dp"
                android:contentDescription="Registration QR Code"
                android:visibility="gone" />




        </LinearLayout>
    </LinearLayout>

</ScrollView>