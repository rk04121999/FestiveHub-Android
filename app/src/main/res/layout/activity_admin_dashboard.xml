<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="45dp"
            android:gravity="center"
            android:text="Admin Dashboard"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="Festive Hub Administration"
            android:textColor="#666666"
            android:textSize="18sp" />

        <Button
            android:id="@+id/adminEventsButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="15dp"
            android:text="Events"
            android:textSize="18sp" />

        <Button
            android:id="@+id/adminStudentsButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="15dp"
            android:text="Students"
            android:textSize="18sp" />

        <Button
            android:id="@+id/adminVolunteersButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="15dp"
            android:text="Volunteers"
            android:textSize="18sp" />

        <Button
            android:id="@+id/adminCollegeButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="15dp"
            android:text="College List"
            android:textSize="18sp" />

        <Button
            android:id="@+id/adminNotificationsButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="30dp"
            android:text="Notifications"
            android:textSize="18sp" />

        <Button
            android:id="@+id/adminLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Logout"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>